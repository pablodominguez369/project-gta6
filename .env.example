# Copy to .env.local and fill in local, non-production values only.
# Never commit real secrets. Production secrets live in the secret manager.
# Validated at start-up by packages/config (see src/schemas.ts).

# --- All processes ---------------------------------------------------------
# Runtime environment: local | staging | production
APP_ENV=local
# Log level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# --- Public (exposed to the browser) ----------------------------------------
# Local values are printed by `pnpm supabase start` (from task T5).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...), printed by `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server and worker only (SECRET: never prefix with NEXT_PUBLIC_) ---------
# Secret key (sb_secret_...). Bypasses RLS.
SUPABASE_SECRET_KEY=

# --- Worker only ------------------------------------------------------------
# Direct connection or session pooler; transaction pooling is not supported by the queue.
DATABASE_URL=
# Only "simulated" is accepted in Phase 1. Any other value stops the worker.
PUBLISHING_MODE=simulated
