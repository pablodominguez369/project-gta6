{
  "name": "gta6-media-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase db start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
